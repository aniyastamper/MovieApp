<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieApp.Views.AddPage">
    <ContentPage.Content>
        
        <StackLayout Padding="20,20">
            <Label Text="Add Movie Title" FontSize="Large" Margin="0,40,0,20"/>
            <Border Stroke="Gray" StrokeThickness="1">
                <Entry x:Name="txtTitle"/>
            </Border>
            
            <Label Text="Add Movie Rating" FontSize="Large" Margin="0,80,0,20" />
            <Border Stroke="Gray" StrokeThickness="1">
                <Entry x:Name="txtRating" IsTextPredictionEnabled="False"/>
            </Border>

            <Button Text="Add Movie" Clicked="AddMovie_OnClicked" Margin="0,20"/>
            
        </StackLayout>
        
    </ContentPage.Content>
</ContentPage>